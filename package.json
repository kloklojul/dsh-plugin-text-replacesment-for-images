{
  "name": "dsh-image-to-text",
  "version": "0.2.1",
  "description": "Durable vision-to-text interception for DeepSeek Harness user images and tool screenshots",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kloklojul/dsh-plugin-text-replacesment-for-images.git"
  },
  "homepage": "https://github.com/kloklojul/dsh-plugin-text-replacesment-for-images#readme",
  "bugs": "https://github.com/kloklojul/dsh-plugin-text-replacesment-for-images/issues",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./projection": {
      "types": "./lib/projection.d.ts",
      "default": "./lib/projection.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "tsconfig.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.27.0",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
